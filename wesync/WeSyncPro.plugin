[Script]
http-response ^https://(cf|hs)\.wesync\.cloud/api/subscription/status script-path=https://raw.githubusercontent.com/yuu0402/loon/main/wesync/WeSyncPro.js, requires-body=true, timeout=15, tag=WeSync Pro 解锁

[Mitm]
hostname = cf.wesync.cloud, hs.wesync.cloud
