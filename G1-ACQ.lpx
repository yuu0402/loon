#!name=G1 ACQ
#!desc=Google One SKU 改写与采集：Ultra 1个月免费试用（20TB/30TB）、2TB 12个月一折测试、被动采集原始SKU。v7.6.0 Loon 移植版，源项目 github.com/crhywun/g1-acq。仅 MitM one.google.com，数据不出本机。
#!author=crhywun（山田小姐移植 Loon 版）
#!tag=Google
#!homepage=https://github.com/crhywun/g1-acq
#!icon=https://raw.githubusercontent.com/Orz-3/mini/master/Color/Google.png
#!date=2026-11-25

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP（Loon 实测支持 REJECT-NO-DROP，与 Surge 语义一致）
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
http-response ^https:\/\/one\.google\.com\/ tag=g1-acq, script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.6.0/g1-acq.js, requires-body=true, timeout=60
http-request ^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$ tag=g1-sku-report, script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.6.0/g1-sku-report.js, timeout=60

[Mitm]
hostname = one.google.com
